# Azure AD App Registration credentials
# See: https://learn.microsoft.com/en-us/azure/active-directory/develop/quickstart-register-app

MDE_TENANT_ID=your-tenant-id
MDE_CLIENT_ID=your-client-id
MDE_CLIENT_SECRET=your-client-secret

# Optional: MCP transport settings (default: stdio)
# MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=8000

# Required when binding HTTP outside loopback (including Docker's default 0.0.0.0).
# Generate a random token of at least 32 characters; configure the same bearer token in clients.
# MCP_AUTH_TOKEN=
# MCP_PUBLIC_URL=https://your-private-mcp-host.example/mcp

# Optional Graph client limits
# MDE_MAX_CONCURRENCY=4
# MDE_QUERY_TIMEOUT=180
# MDE_MAX_RETRIES=2

# Background recent-data inventory: metadata names followed by paced P7D take-1 checks.
# MCP initialization does not wait for this work. Disable to list full metadata only.
# MDE_PRESENCE_ENABLED=true
# MDE_PRESENCE_CACHE_TTL=3600
