# Azure AD App Registration credentials
# See: https://learn.microsoft.com/en-us/azure/active-directory/develop/quickstart-register-app

MDE_TENANT_ID=your-tenant-id
MDE_CLIENT_ID=your-client-id
MDE_CLIENT_SECRET=your-client-secret

# Optional: MCP transport settings (default: stdio)
# MCP_TRANSPORT=stdio
# MCP_HOST=0.0.0.0
# MCP_PORT=8000
